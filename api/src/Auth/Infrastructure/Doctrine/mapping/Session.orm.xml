<?xml version="1.0" encoding="UTF-8"?>
<!-- Sessions : seule l'empreinte SHA-256 du secret du cookie est stockée. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Auth\Domain\Session" table="auth_session">
        <indexes>
            <index name="idx_auth_session_compte" columns="compte_id"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_auth_session_empreinte" columns="empreinte"/>
        </unique-constraints>
        <id name="id" type="string" length="36"/>
        <field name="compteId" column="compte_id" type="string" length="36"/>
        <field name="empreinte" type="string" length="64"/>
        <field name="appareil" type="string" length="120"/>
        <field name="creeLe" column="cree_le" type="datetime_immutable"/>
        <field name="derniereActivite" column="derniere_activite" type="datetime_immutable"/>
        <field name="fermeeLe" column="fermee_le" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
