<?xml version="1.0" encoding="UTF-8"?>
<!-- Disponibilités réglées depuis le back-office : le domaine reste sans annotation ni dépendance à Doctrine. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Booking\Domain\Disponibilites" table="booking_disponibilites">
        <id name="id" type="string" length="10"/>
        <field name="joursTravailles" column="jours_travailles" type="json"/>
        <field name="creneaux" type="json"/>
        <field name="joursFermes" column="jours_fermes" type="json"/>
    </entity>
</doctrine-mapping>
