<?xml version="1.0" encoding="UTF-8"?>
<!-- Devis : un par demande, lignes en JSON. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Prospect\Domain\Devis" table="prospect_devis">
        <unique-constraints>
            <unique-constraint name="uniq_prospect_devis_demande" columns="demande_id"/>
        </unique-constraints>
        <id name="id" type="string" length="36"/>
        <field name="demandeId" column="demande_id" type="string" length="36"/>
        <field name="numero" type="string" length="12"/>
        <field name="lignes" type="json"/>
        <field name="total" type="integer"/>
        <field name="statut" type="string" length="20" enum-type="App\Prospect\Domain\StatutDevis"/>
        <field name="envoyeLe" column="envoye_le" type="datetime_immutable"/>
        <field name="accepteLe" column="accepte_le" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
