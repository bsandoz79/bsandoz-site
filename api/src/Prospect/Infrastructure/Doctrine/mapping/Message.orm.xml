<?xml version="1.0" encoding="UTF-8"?>
<!-- Fil de messages d'une demande : le domaine reste sans annotation ni dépendance à Doctrine. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Prospect\Domain\Message" table="prospect_message">
        <indexes>
            <index name="idx_prospect_message_demande" columns="demande_id,cree_le"/>
        </indexes>
        <unique-constraints>
            <unique-constraint name="uniq_prospect_message_mail" columns="id_mail"/>
        </unique-constraints>
        <id name="id" type="string" length="36"/>
        <field name="demandeId" column="demande_id" type="string" length="36"/>
        <field name="auteur" type="string" length="20" enum-type="App\Prospect\Domain\AuteurMessage"/>
        <field name="origine" type="string" length="10" enum-type="App\Prospect\Domain\OrigineMessage"/>
        <field name="corps" type="text"/>
        <field name="creeLe" column="cree_le" type="datetime_immutable"/>
        <field name="idMail" column="id_mail" type="string" length="64" nullable="true"/>
    </entity>
</doctrine-mapping>
