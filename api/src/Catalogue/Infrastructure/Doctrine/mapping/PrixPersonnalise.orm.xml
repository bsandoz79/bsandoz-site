<?xml version="1.0" encoding="UTF-8"?>
<!-- Prix modifiés depuis le back-office : le domaine reste sans annotation ni dépendance à Doctrine. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Catalogue\Domain\PrixPersonnalise" table="catalogue_prix">
        <id name="cle" type="string" length="60"/>
        <field name="montant" type="integer"/>
    </entity>
</doctrine-mapping>
