{
  "name": "@bsandoz79/blocs",
  "version": "1.0.0",
  "description": "Blocs d'interface React réutilisables (calendrier, cartes d'options, aperçu de site…), indépendants de tout site.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/blocs.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/blocs.js"
    },
    "./styles.css": "./dist/blocs.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsandoz79/bsandoz-site.git",
    "directory": "packages/blocs"
  },
  "publishConfig": {
